# =============================================================================
# pCloud API
# =============================================================================
PCLOUD_TOKEN=<TOKEN>
PCLOUD_HOST=eapi.pcloud.com
PCLOUD_PORT=8399
PCLOUD_DEVICE=entropywatcher/raspi

# Binary-API-Timeout (Sekunden). Nur PCLOUD_TIMEOUT setzen (nicht TIMEOUT_SECS).
PCLOUD_TIMEOUT=120

PCLOUD_UPLOAD_METHOD=uploadfile
PCLOUD_DEFAULT_FOLDERID=0
PCLOUD_PRETTY_JSON=1

# Remote Pool-Root (Wrapper-Default: /Backup/rtb_pool)
PCLOUD_DEST=/Backup/rtb_pool

# =============================================================================
# Lokale Pfade (pi-nas: SSD2, nicht Micro-SD)
# =============================================================================
# PCLOUD_TEMP_DIR: Index-Staging, Delta-Reports waehrend Upload
PCLOUD_TEMP_DIR=/srv/pcloud-temp

# PCLOUD_ARCHIVE_DIR: Manifeste, Index-Master, Deltas
PCLOUD_ARCHIVE_DIR=/srv/pcloud-archive

# =============================================================================
# Parallelitaet (eine Variable pro Aufgabe)
# =============================================================================
# Datei-Uploads (Full-Pool und Delta Phase 4)
PCLOUD_UPLOAD_THREADS=16

# Snapshot-Ordner anlegen
PCLOUD_FOLDER_THREADS=8

# Pool-Ordner 00-FF anlegen
PCLOUD_POOL_FOLDER_THREADS=8

# Nach Upload: fileid/hash per stat nachladen wenn API-Antwort leer (1=an, default)
PCLOUD_EAGER_FILEID=1
# Nach Upload-Fehler: einmal stat prüfen ob Pool-Objekt trotzdem existiert (1=an, default)
PCLOUD_POOL_RECOVER_ON_ERROR=1

# Stub-Batch-Write
PCLOUD_STUB_THREADS=8
# Parent-FolderID-Auflösung vor Stub-Write (parallel, default = API_META_CONCURRENCY)
PCLOUD_STUB_FID_THREADS=6

# copyfolder (grosse Snapshots, Sekunden)
PCLOUD_COPYFOLDER_TIMEOUT=2400
PCLOUD_COPYFOLDER_ATTEMPTS=3

# deletefolderrecursive auf grossen Snapshots (Sekunden)
PCLOUD_DELETE_MAX_WAIT_SEC=3600
PCLOUD_DELETE_POLL_SEC=30

# =============================================================================
# API-Schonung (Verbindungs-Sturm, nicht Geschwindigkeit)
# =============================================================================
PCLOUD_API_META_CONCURRENCY=6
PCLOUD_API_META_DELAY=0.03
PCLOUD_CIRCUIT_BREAKER_ERRORS=12
# Pause (Sek.) nach Auslösung, dann HALF-OPEN-Probe; verdoppelt sich pro Tier
PCLOUD_CIRCUIT_BREAKER_COOLDOWN_SEC=60
# Erfolgreiche API-Calls bis Parallelität eine Stufe hochdreht (z.B. 12→16 Threads)
PCLOUD_CIRCUIT_RECOVERY_SUCCESSES=30
# Parallelitäts-Faktoren bei Tier 0/1/2 (1.0=volle Threads, 0.75≈12 von 16, 0.5≈8 von 16)
PCLOUD_CIRCUIT_PARALLELISM_TIERS=1,0.75,0.5

# =============================================================================
# Pool-Finalize (RAM-sparend, pi-nas)
# =============================================================================
PCLOUD_VALIDATE_BATCH_SIZE=5000
PCLOUD_VALIDATE_THREADS=8
PCLOUD_RESUME_CHUNK_MB=128
PCLOUD_CHUNK_DELAY=0.3

# =============================================================================
# Smart-Strategy (Scout / Turbo-Delta)
# =============================================================================
PCLOUD_SMART_STUB_TRANSFORM_THRESHOLD=0.80
PCLOUD_SMART_SAVED_CALLS_MIN=1000
PCLOUD_SMART_TEMPLATE_STRONG_THRESHOLD=0.90

# =============================================================================
# Remote-Retention (pcloud_pool_gc.py)
# =============================================================================
PCLOUD_REMOTE_RETENTION_DAYS_FULL=62
PCLOUD_REMOTE_RETENTION_WEEKLY_WEEKS=54
PCLOUD_RETENTION_DELETE_POLL_SEC=60
PCLOUD_RETENTION_DELETE_TIMEOUT_SEC=1200

# =============================================================================
# Integrity-Gate (Default: listfolder vor .upload_complete)
# pool_verify_backup: Post-Upload nutzt Snap-Archiv-Index + subtree listfolder (keine Extra-Env noetig)
# =============================================================================
# PCLOUD_VALIDATE_UPLOAD=0          # 0=listfolder-Gate (~60s), 1=legacy stat (~40min)
# PCLOUD_POST_UPLOAD_INTEGRITY=skip # Wrapper: kein redundanter zweiter Lauf
# PCLOUD_VALIDATE_POOL_BACKFILL_MAX=50
# PCLOUD_MARKER_VERIFY_RETRIES=5
# PCLOUD_MARKER_VERIFY_RETRY_SEC=2
# PCLOUD_MANIFEST_REF_MAX_CANDIDATES=6

# Catch-up: max. 1 Backlog-Snap pro Pipeline-Lauf (0 = unbegrenzt)
PCLOUD_CATCHUP_MAX_PER_RUN=1

# =============================================================================
# Optional
# =============================================================================
# PCLOUD_POST_UPLOAD_INTEGRITY=1   # zweiter Wrapper-Lauf (nur Audit)
# PCLOUD_DELTA_PROGRESS_EVERY=100
# PCLOUD_JSON_STAGING_LOG=1
# PCLOUD_STUB_FID_PROGRESS_EVERY=100
# PCLOUD_STUB_FID_HEARTBEAT_SEC=60
# PCLOUD_MANIFEST_SKIP_GLOBS=**/__pycache__/**,**/*.pyc

# PCLOUD_ENABLE_DB=0
# PCLOUD_DB_HOST=localhost
# PCLOUD_DB_PORT=3306
# PCLOUD_DB_NAME=pcloud_backup
# PCLOUD_DB_USER=pcloud_backup
# PCLOUD_DB_PASS=CHANGE_ME_STRONG_PASSWORD

# PCLOUD_LOG=/var/log/backup/pcloud_sync.log
# PCLOUD_ENABLE_JSONL=0
# PCLOUD_JSONL_LOG=/var/log/backup/pcloud_sync.jsonl
