# pCloud Login
PCLOUD_TOKEN=<TOKEN>

#PCLOUD_HOST="eu.api.pcloud.com"      # oder api.pcloud.com eu.api.pcloud.com
PCLOUD_HOST="eapi.pcloud.com"
PCLOUD_PORT="8399"
PCLOUD_TIMEOUT_SECS="90"
PCLOUD_UPLOAD_METHOD="uploadfile" # bei Bedarf ändern
PCLOUD_DEFAULT_FOLDERID="0"


PCLOUD_TIMEOUT="30"
PCLOUD_DEVICE="entropywatcher/raspi"

# json menschen lesbar =1, statt minified = default oder 0
PCLOUD_PRETTY_JSON=1

# Pfade für temporäre und archivierte Dateien (pi-nas: Bind-Mounts auf SSD2)
# PCLOUD_TEMP_DIR: Temp während Upload → /srv/pcloud-temp (nicht /tmp, nicht Micro-SD)
# PCLOUD_ARCHIVE_DIR: Manifeste, Index, Deltas → /srv/pcloud-archive
# NICHT verwenden: /srv/nas/pcloud-archive (separater mergerfs-Baum, s. docs/STORAGE_PATHS.md)
PCLOUD_TEMP_DIR="/srv/pcloud-temp"
PCLOUD_ARCHIVE_DIR="/srv/pcloud-archive"

# Remote Pool-Root auf pCloud (Wrapper-Default: /Backup/rtb_pool)
# Pflicht fuer manuelle Checks (pcloud_quick_delta, pool_verify_backup) bei source .env
PCLOUD_DEST="/Backup/rtb_pool"

# =====================================================
# MariaDB Run-History Tracking (Optional)
# =====================================================
# Requires: MariaDB server (apt install mariadb-server mariadb-client)
# Setup: mysql < sql/init_pcloud_db.sql

# Database connection
PCLOUD_DB_HOST=localhost
PCLOUD_DB_PORT=3306
PCLOUD_DB_NAME=pcloud_backup
PCLOUD_DB_USER=pcloud_backup
PCLOUD_DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Feature toggle (0=disabled, 1=enabled)
PCLOUD_ENABLE_DB=0

# =====================================================
# Structured Logging (Optional)
# =====================================================
# Human-readable log file
PCLOUD_LOG=/var/log/backup/pcloud_sync.log

# Machine-parseable JSON Lines log (for log aggregation)
PCLOUD_ENABLE_JSONL=0
PCLOUD_JSONL_LOG=/var/log/backup/pcloud_sync.jsonl

# Post-Upload Integritaetscheck (pool_integrity_run.py, ein Snapshot, DB-Tracking)
# 1 = aktiv (default), skip = ueberspringen
# PCLOUD_POST_UPLOAD_INTEGRITY=1

# Deprecated: pcloud_quick_delta nach Upload (OOM-Risiko) — nicht mehr vom Wrapper genutzt
# PCLOUD_POST_UPLOAD_DELTA=skip

# Manifest-Scan: Pfade nicht in Pool-Manifest (analog rtb excludes)
# PCLOUD_MANIFEST_SKIP_GLOBS=**/__pycache__/**,**/*.pyc

# Remote-Retention (Zeit-Policy in pcloud_pool_gc.py --retention-apply)
# 0 = RTB-Spiegel (remote ohne lokales RTB loeschen)
# >0 = alle Snaps der letzten N Tage + aelter 1 pro ISO-Woche, max W Wochen
# PCLOUD_REMOTE_RETENTION_DAYS_FULL=62
# PCLOUD_REMOTE_RETENTION_WEEKLY_WEEKS=54

# Warten auf pCloud-Loeschung grosser Snapshot-Ordner (Retention)
# PCLOUD_RETENTION_DELETE_POLL_SEC=60
# PCLOUD_RETENTION_DELETE_TIMEOUT_SEC=1200

# =====================================================
# Pool-Finalize (RAM-sparend, pi-nas)
# =====================================================
# Post-Upload: stat()-Validation in Batches statt listfolder-Gesamtbaum.
# Faustformel Batch-Groesse: item_count / 15  (~15-25 Log-Zeilen pro Phase)
#   ~80k Pool-SHAs  -> 5000  (~16 Batches)
#   ~110k Stubs     -> 5000  (~22 Batches)
# PCLOUD_VALIDATE_BATCH_SIZE=5000
# PCLOUD_VALIDATE_THREADS=8
# PCLOUD_VALIDATE_FAIL_LIMIT=50
# PCLOUD_VALIDATE_STUB_FULL=1
# PCLOUD_VALIDATE_POOL_BACKFILL_MAX=50
#
# Index/Manifest-Upload: JSON lokal auf SSD, dann resumable
# PCLOUD_RESUME_CHUNK_MB=128
# PCLOUD_INDEX_UPLOAD_LOG_EVERY_CHUNKS=1

