[Unit]
Description=Monitoring Status Update Timer - Event-triggered + fallback
Documentation=https://github.com/lastphoenx/pcloud-tools
Requires=monitoring-status-update.service

[Timer]
# Post-backup full aggregate: backup-pipeline.service OnSuccess=monitoring-status-update.service
# (nicht OnUnitActivation — feuert beim Start, kollidiert mit laufender Pipeline)
# Every 15 minutes — RTB --check-only + pCloud health (~3–6 min on large NAS)
OnCalendar=*:0/15
# Startup: after mergerfs/USB are up
OnBootSec=10min

# Tolerance: Allow jitter to spread load across multiple timers
AccuracySec=1m
# Persistence: Still run if system was off at scheduled time
Persistent=true

[Install]
WantedBy=timers.target
