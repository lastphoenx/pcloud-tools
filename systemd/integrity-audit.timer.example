[Unit]
Description=pCloud integrity audit after backup (+105min, 10 snapshots)
Documentation=file:///opt/apps/pcloud-tools/main/docs/POOL_INTEGRITY.md

[Timer]
# Backup 04:00 / 12:00 / 20:00 → Audit +105min
OnCalendar=*-*-* 05:45:00
OnCalendar=*-*-* 13:45:00
OnCalendar=*-*-* 21:45:00
Persistent=true
RandomizedDelaySec=300
Unit=integrity-audit.service

[Install]
WantedBy=timers.target
