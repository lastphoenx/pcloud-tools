[Unit]
Description=Daily pCloud integrity audit (one snapshot per day)
Documentation=file:///opt/apps/pcloud-tools/main/systemd/README.md

[Timer]
# Taeglich 03:30 — bei ~86 Snapshots voller Zyklus in ~3 Monaten;
# bei Bedarf OnCalendar=*-*-* 03:30,06:30,21:30 fuer 3x/Tag (~1 Monat Zyklus)
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
