[Unit]
Description=Monitoring Status Update (quick) - Services, log, timers
Documentation=https://github.com/lastphoenx/pcloud-tools
After=network.target

[Service]
Type=oneshot
User=root
Group=root

SuccessExitStatus=0 1 2

WorkingDirectory=/opt/apps/pcloud-tools/main/scripts
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="AGGREGATE_MODE=quick"

ExecStart=/opt/apps/pcloud-tools/main/scripts/aggregate_status.sh

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/apps/monitoring
ReadWritePaths=/run
ReadOnlyPaths=/opt/apps/pcloud-tools
ReadOnlyPaths=/opt/apps/entropywatcher
ReadOnlyPaths=/opt/apps/rtb
ReadOnlyPaths=/srv/nas
ReadOnlyPaths=/srv/pcloud-archive
ReadOnlyPaths=/srv/pcloud-temp
ReadOnlyPaths=/mnt/backup
ReadOnlyPaths=/var/log/backup
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitoring-status-quick

[Install]
WantedBy=multi-user.target
