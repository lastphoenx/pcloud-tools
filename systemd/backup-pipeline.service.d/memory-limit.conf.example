[Service]
# RAM-Schutz: Backup-Pipeline darf System nicht ersticken (OOM/Thrashing)
MemoryMax=5G
MemorySwapMax=1G
OOMScoreAdjust=500
# Lange copyfolder/API-Wartezeiten: keine Unit-Watchdog-Supervision fuer diesen Job
# (globaler Hardware-Watchdog: siehe systemd/system.conf.d/watchdog-longops.conf.example)
RuntimeWatchdogSec=0
