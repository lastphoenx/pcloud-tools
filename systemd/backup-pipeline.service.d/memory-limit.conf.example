# OPTIONAL — nur bei Bedarf aktivieren:
#   sudo cp .../memory-limit.conf.example /etc/systemd/system/backup-pipeline.service.d/memory-limit.conf
#   sudo systemctl daemon-reload
#
# Notfall-Bremse: systemd beendet den Backup-Job, bevor der ganze Pi im Swap hängt.
# Das ist KEIN Performance-Ziel und KEIN Ersatz für Pipeline-Fixes (tee/itemize).
# Ohne diese Datei: kein cgroup-RAM-Deckel — auf pi-nas oft die bessere Wahl.
#
# pi-nas 8GB — wenn du einen Deckel willst, eher ~4G (Rest für SMB/mergerfs/MariaDB):
[Service]
MemoryMax=4G
MemorySwapMax=1G
OOMScoreAdjust=500
