[Unit]
Description=Monitoring Dashboard Web Server
Documentation=https://github.com/lastphoenx/pcloud-tools
After=network.target
Wants=monitoring-status-update.timer

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
Restart=on-failure
RestartSec=10s

# Environment
# WICHTIG: WorkingDirectory muss das gemeinsame Parent-Verzeichnis sein!
# Dies ermöglicht absolute Pfade wie /pcloud-tools/dashboard/ und /entropy-watcher-und-clamav-scanner/docs/
WorkingDirectory=/opt/apps
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Execution
# Python HTTP server mit custom handler für cache control und multi-repo routing
# Script liegt im pcloud-tools Repo, läuft aber mit WorkingDirectory=/opt/apps
ExecStart=/usr/bin/python3 /opt/apps/pcloud-tools/main/monitoring-dashboard-server.py

# Security
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/apps/pcloud-tools/main
ReadOnlyPaths=/opt/apps/entropywatcher/main
ReadOnlyPaths=/opt/apps/monitoring
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=1024

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitoring-dashboard

[Install]
WantedBy=multi-user.target
